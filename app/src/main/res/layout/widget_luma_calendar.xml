<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:padding="0dp">

    <!-- Top Gradient Header Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_header_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="7dp"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/widget_month_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="شهریور"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="normal"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Main Content: Day number & secondary calendar values with intentional whitespace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۲۵"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Balanced Secondary Calendars (Gregorian & Hijri) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_secondary_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="۱۶"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:textStyle="normal"
                android:includeFontPadding="false" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/widget_secondary_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="۳"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:textStyle="normal"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
